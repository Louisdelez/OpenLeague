{
  "output": {
    "filePath": ".ai-tools/state/context.xml",
    "style": "xml",
    "showLineNumbers": true,
    "removeEmptyLines": false
  },
  "include": ["AGENTS.md", "docs/ai/**/*.md", "docs/ARCHITECTURE.md", "docs/BUILDING.md", "docs/ROADMAP.md", "docs/GIT_WORKFLOW.md", "docs/VERSIONING.md", "Cargo.toml", "launcher/src-tauri/tauri.conf.json"],
  "ignore": {"useGitignore": true, "useDefaultPatterns": true, "customPatterns": ["**/.env*", "**/*.key", "**/*.pem", "**/node_modules/**", "**/.venv/**", ".ai-tools/state/**"]},
  "security": {"enableSecurityCheck": true}
}
