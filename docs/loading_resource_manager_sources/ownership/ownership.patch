+/// Fixed-capacity ownership reserved on the caller stack before acquisition.
+/// Slot order is construction order; cleanup runs in reverse and attempts
+/// every owner even if an earlier cleanup fails. No Vec growth can lose a guard.
+#[derive(Debug, PartialEq, Eq)]
+#[must_use = "Every occupied slot and its descriptor lease must be finished or retained"]
+pub struct Group<const N:usize> { slots:[Option<Temporary>;N] }
+pub struct Vacant<'a> { slot:&'a mut Option<Temporary> }
+impl<'a> Vacant<'a> {
+    /// Capacity/slot availability was checked before constructing the owner.
+    /// Adoption itself performs no allocation, read, write or fallible action.
+    pub fn adopt(self,owner:Temporary)->&'a mut Temporary { self.slot.insert(owner) }
+}
+impl<const N:usize> Group<N> {
+    pub fn new(slots:[Option<Temporary>;N])->Self {Self {slots}}
+    pub fn get(&self,index:usize)->Option<&Temporary> {self.slots.get(index)?.as_ref()}
+    pub fn get_mut(&mut self,index:usize)->Option<&mut Temporary> {self.slots.get_mut(index)?.as_mut()}
+    pub fn vacant(&mut self,index:usize)->Result<Vacant<'_>,Error> {
+        let slot=self.slots.get_mut(index).ok_or(Error::Boundary("temporary group slot is out of range"))?;
+        if slot.is_some(){return Err(Error::Boundary("temporary group slot is already owned"));}
+        Ok(Vacant {slot})
+    }
+    pub fn remaining_count(&self)->usize {self.slots.iter().filter(|s|s.is_some()).count()}
+    pub fn into_array(self)->[Option<Temporary>;N] {self.slots}
+    pub fn retire(&mut self,b:&mut impl Boundary)->[Option<Error>;N] {
+        let mut errors=std::array::from_fn(|_|None);
+        for index in (0..N).rev() {
+            if let Some(owner)=&mut self.slots[index] {
+                errors[index]=owner.retire(b).err();
+                if owner.is_retired(){self.slots[index]=None;}
+            }
+        }
+        errors
+    }
+}
+#[derive(Debug, PartialEq, Eq)]
+#[must_use = "Retain all remaining guards and their descriptor leases before reporting"]
+pub struct GroupFailure<const N:usize> {
+    pub primary:Option<Error>,
+    /// First cleanup errors stay separate by owner, even after successful retry.
+    pub cleanup:[Option<Error>;N],
+    pub remaining:Group<N>,
+}
+pub fn finish_group<T,const N:usize>(
+    b:&mut impl Boundary,mut owners:Group<N>,primary:Result<T,Error>,
+)->Result<T,GroupFailure<N>> {
+    let cleanup=owners.retire(b);
+    if cleanup.iter().all(Option::is_none) {
+        if let Ok(value)=primary {return Ok(value);}
+    }
+    Err(GroupFailure {primary:primary.err(),cleanup,remaining:owners})
 }
 
