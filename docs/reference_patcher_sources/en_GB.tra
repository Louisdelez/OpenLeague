tr "pando_removal_popup_header" = "Remove Pando Media Booster?"
tr "pando_removal_popup_body_1" = "We've detected that you have Pando Media Booster installed on your computer.  League of Legends previously used this to speed up downloading but now it doesn't really do anything and is no longer a supported program."
tr "pando_removal_popup_body_2" = "We encourage you to uninstall - want us to remove it for you?"
