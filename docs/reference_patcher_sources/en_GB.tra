tr "unsafe_uninstall_title" = "Possible Unsafe Installation"
tr "unsafe_uninstall_message" = "The PVP.net Patcher has detected that you have an install of League of Legends which may cause damage to files on your computer when it is uninstalled, due to a bug in the older LoL installers. A program will now be launched to fix this issue. It may need to ask permission to modify files, please allow this access if requested."
tr "unsafe_uninstall_warning" = "The program to fix the uninstaller did not run correctly, or was not granted the required access. Your computer may still be at risk. This process will repeat automatically next time the game is run, until the issues have been fixed."
tr "unsafe_uninstall_success" = "The issues have been successfully corrected. Your files should no longer be at risk. Thank you for your patience."

