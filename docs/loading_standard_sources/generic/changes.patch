+    let proof=fixture();
+    let c=proof["cases"].as_array().unwrap().iter().find(|c|c["profile"]=="heap_growth" && c["fill"]==165).unwrap();
+    let entry=&c["events"].as_array().unwrap().iter().find(|e|e["op"]=="prefix_entry").unwrap()["string"];
