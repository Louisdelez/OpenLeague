<config:ModuleEntry xmlns:config="com.riotgames.platform.gameclient.config.*" xmlns:utils="flash.utils.*" xmlns:fx="http://ns.adobe.com/mxml/2009">
    <config:extraData>
        <utils:Dictionary>
            <utils:profileScreen>
                <fx:String>CLS</fx:String>
            </utils:profileScreen>
        </utils:Dictionary>
    </config:extraData>
    <config:modulePath>mod/lsi/mod_lsi.dat</config:modulePath>
    <config:name>CLS</config:name>
    <config:providers>
        <fx:Vector type="com.riotgames.platform.gameclient.config.ProviderEntry">
            <config:ProviderEntry>
                <config:interfaceClassName>com.riotgames.platform.common.provider::ICLSProvider</config:interfaceClassName>
            </config:ProviderEntry>
        </fx:Vector>
    </config:providers>
</config:ModuleEntry>