<config:ModuleEntry xmlns:config="com.riotgames.platform.gameclient.config.*" xmlns:fx="http://ns.adobe.com/mxml/2009" xmlns:utils="flash.utils.*">
    <config:extraData>
        <utils:Dictionary>
            <utils:mainScreen>
                <fx:String>endofgamegiftwindow</fx:String>
            </utils:mainScreen>
        </utils:Dictionary>
    </config:extraData>
    <config:modulePath>mod/eogg/mod_eogg.dat</config:modulePath>
    <config:name>EndOfGameGiftWindow</config:name>
    <config:providers>
        <fx:Vector type="com.riotgames.platform.gameclient.config.ProviderEntry">
            <config:ProviderEntry>
                <config:interfaceClassName>com.riotgames.pvpnet.endofgamegiftwindow::IEndOfGameGiftWindowProvider</config:interfaceClassName>
            </config:ProviderEntry>
        </fx:Vector>
    </config:providers>
</config:ModuleEntry>