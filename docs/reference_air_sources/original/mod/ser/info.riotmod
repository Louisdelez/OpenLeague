<config:ModuleEntry xmlns:config="com.riotgames.platform.gameclient.config.*" xmlns:utils="flash.utils.*" xmlns:fx="http://ns.adobe.com/mxml/2009">
    <config:modulePath>mod/ser/mod_ser.dat</config:modulePath>
    <config:name>Services</config:name>
    <config:providers>
        <fx:Vector type="com.riotgames.platform.gameclient.config.ProviderEntry">
            <config:ProviderEntry>
                <config:interfaceClassName>com.riotgames.platform.common.provider::IServicesProvider</config:interfaceClassName>
            </config:ProviderEntry>
        </fx:Vector>
    </config:providers>
	<config:extraData>
		<utils:Dictionary>
			<utils:servicesMode>
				<fx:int>1</fx:int>
			</utils:servicesMode>
		</utils:Dictionary>
	</config:extraData>
</config:ModuleEntry>