<config:ModuleEntry xmlns:config="com.riotgames.platform.gameclient.config.*" xmlns:fx="http://ns.adobe.com/mxml/2009">
    <config:extraData/>
    <config:modulePath>mod/mtrk/cmmtrks.dat</config:modulePath>
    <config:name>Metrics</config:name>
    <config:providers>
        <fx:Vector type="com.riotgames.platform.gameclient.config.ProviderEntry">
            <config:ProviderEntry>
                <config:interfaceClassName>com.riotgames.platform.common.provider::IMetricsProvider</config:interfaceClassName>
            </config:ProviderEntry>
            <config:ProviderEntry>
                <config:interfaceClassName>com.riotgames.pvpnet.tracking::ICrossModuleTrackerProvider</config:interfaceClassName>
            </config:ProviderEntry>
            <config:ProviderEntry>
                <config:interfaceClassName>com.riotgames.platform.common.provider::ISessionMetricsProvider</config:interfaceClassName>
            </config:ProviderEntry>
        </fx:Vector>
    </config:providers>
</config:ModuleEntry>