<config:ModuleEntry xmlns:config="com.riotgames.platform.gameclient.config.*" xmlns:fx="http://ns.adobe.com/mxml/2009">
    <config:extraData/>
    <config:modulePath>mod/man/mod_man.dat</config:modulePath>
    <config:name>Main</config:name>
    <config:providers>
        <fx:Vector type="com.riotgames.platform.gameclient.config.ProviderEntry">
            <config:ProviderEntry>
                <config:interfaceClassName>com.riotgames.platform.common.provider::IMainProvider</config:interfaceClassName>
            </config:ProviderEntry>
            <config:ProviderEntry>
                <config:interfaceClassName>com.riotgames.platform.gameclient.views::IEndOfGameScoreboardProvider</config:interfaceClassName>
            </config:ProviderEntry>
            <config:ProviderEntry>
                <config:interfaceClassName>com.riotgames.platform.gameclient.views::IEndOfGameProvider</config:interfaceClassName>
            </config:ProviderEntry>
            <config:ProviderEntry>
                <config:interfaceClassName>com.riotgames.platform.common.provider::IGameProvider</config:interfaceClassName>
            </config:ProviderEntry>
            <config:ProviderEntry>
                <config:interfaceClassName>com.riotgames.platform.common.provider::IChampionImagesProvider</config:interfaceClassName>
            </config:ProviderEntry>
            <config:ProviderEntry>
                <config:interfaceClassName>com.riotgames.pvpnet.practice::ICreatePracticeGameProvider</config:interfaceClassName>
            </config:ProviderEntry>
            <config:ProviderEntry>
                <config:interfaceClassName>com.riotgames.pvpnet.navigation::INavigationProvider</config:interfaceClassName>
            </config:ProviderEntry>
        </fx:Vector>
    </config:providers>
</config:ModuleEntry>