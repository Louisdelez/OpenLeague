<config:ModuleEntry xmlns:config="com.riotgames.platform.gameclient.config.*" xmlns:utils="flash.utils.*" xmlns:fx="http://ns.adobe.com/mxml/2009">
    <config:extraData>
        <utils:Dictionary>
            <utils:mainScreen>
                <fx:String>tips</fx:String>
            </utils:mainScreen>
        </utils:Dictionary>
    </config:extraData>
    <config:modulePath>mod/tips/mod_tips.dat</config:modulePath>
    <config:name>Tips</config:name>
    <config:providers>
        <fx:Vector type="com.riotgames.platform.gameclient.config.ProviderEntry">
            <config:ProviderEntry>
                <config:interfaceClassName>com.riotgames.pvpnet.tips::ITipsProvider</config:interfaceClassName>
            </config:ProviderEntry>
        </fx:Vector>
    </config:providers>
</config:ModuleEntry>