<config:ModuleEntry xmlns:config="com.riotgames.platform.gameclient.config.*" xmlns:fx="http://ns.adobe.com/mxml/2009" xmlns:utils="flash.utils.*">
    <config:extraData>
        <utils:Dictionary>
            <utils:mainScreen>
                <fx:String>chat</fx:String>
            </utils:mainScreen>
        </utils:Dictionary>
    </config:extraData>
    <config:modulePath>mod/cht2/mod_cht2.dat</config:modulePath>
    <config:name>Chat</config:name>
    <config:providers>
        <fx:Vector type="com.riotgames.platform.gameclient.config.ProviderEntry">
			<config:ProviderEntry>
                <config:interfaceClassName>com.riotgames.pvpnet.chat::IChatWindowProvider</config:interfaceClassName>
            </config:ProviderEntry>
			<config:ProviderEntry>
                <config:interfaceClassName>com.riotgames.pvpnet.chat::IFriendListProvider</config:interfaceClassName>
            </config:ProviderEntry>
			<config:ProviderEntry>
                <config:interfaceClassName>com.riotgames.pvpnet.docked::IBuddyPanelProvider</config:interfaceClassName>
            </config:ProviderEntry>
			<config:ProviderEntry>
                <config:interfaceClassName>com.riotgames.pvpnet.docked::IDockedChatViewProvider</config:interfaceClassName>
            </config:ProviderEntry>
        </fx:Vector>
    </config:providers>
</config:ModuleEntry>