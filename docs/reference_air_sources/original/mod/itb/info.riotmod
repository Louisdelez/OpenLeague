<config:ModuleEntry xmlns:config="com.riotgames.platform.gameclient.config.*" xmlns:fx="http://ns.adobe.com/mxml/2009" xmlns:utils="flash.utils.*">
    <config:extraData>
        <utils:Dictionary>
            <utils:oldProfile>
                <fx:String>itemSets</fx:String>
            </utils:oldProfile>
            <utils:mainScreen>
                <fx:String>itemSets</fx:String>
            </utils:mainScreen>
        </utils:Dictionary>
    </config:extraData>
    <config:modulePath>mod/itb/mod_itb.dat</config:modulePath>
    <config:name>ItemBrowser</config:name>
    <config:providers>
        <fx:Vector type="com.riotgames.platform.gameclient.config.ProviderEntry">
            <config:ProviderEntry>
                <config:interfaceClassName>com.riotgames.pvpnet.itembrowser::IItemBrowserProvider</config:interfaceClassName>
            </config:ProviderEntry>
        </fx:Vector>
    </config:providers>
</config:ModuleEntry>