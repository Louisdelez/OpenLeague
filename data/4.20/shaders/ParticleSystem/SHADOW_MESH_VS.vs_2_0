#include "IOParam/IODefine_VS.hls"

float4   kColorFactor   : register(c17);    // R3D_SHADER_VS_CONSTANT_PARTICLE_COLOR_FACTOR

struct VS_IN
{
    float4  position    : X3D_VSIN_POSITION;
    float2  texcoord0   : X3D_VSIN_TEXCOORD0;
};

struct VS_OUT
{
    float4  position    : POSITION;
    float4  color0      : COLOR0;
    float3  uv0_depth   : TEXCOORD0;    // xy = uv0, z = depth
};

void main( in VS_IN input, out VS_OUT output )
{
    output.position = mul( input.position, mProj );
    output.color0 = kColorFactor;
    output.uv0_depth.xy = input.texcoord0 * vUVTransform.xy + vUVTransform.zw; 
    output.uv0_depth.z = output.position.z;   // distance from light view origin
}
