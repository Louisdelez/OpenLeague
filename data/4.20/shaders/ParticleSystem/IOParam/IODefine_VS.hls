
// Set for each tree
column_major float4x4 mProj 		: register(c0);
column_major float4x4 mWorld 	    : register(c4);
column_major float4x4 mShadowProj 	: register(c8);

// general parameters
float4   vCamera  	    : register(c12);

// Specific for light 
float4   vLightColor  	: register(c14);
float4   vLightVec1  	: register(c15);

float4   vUVTransform	: register(c232);
