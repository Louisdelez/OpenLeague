////////////////////////////////////////////////////////////////
///
/// Samplers
///
////////////////////////////////////////////////////////////////
sampler SAMPLER0 : register (s0);		///< font texture

////////////////////////////////////////////////////////////////
///
/// Constants
///
////////////////////////////////////////////////////////////////

////////////////////////////////////////////////////////////////
///
/// main
///
////////////////////////////////////////////////////////////////
void
	main
	(
		float2		in_texcoord0	: TEXCOORD0,		///< Input texture coord 0
		float4		in_color0		: COLOR0,			///< Input color 0
		out float4	out_color0		: COLOR0			///< Output color
	)
{
	// Read textures
	float texel0a = tex2D(SAMPLER0, in_texcoord0).x;
	
	// Modulate with color and return
	out_color0.rgb = in_color0.rgb;

    // Extract a single channel to be the alpha
    out_color0.a = in_color0.a * texel0a;
} // main
