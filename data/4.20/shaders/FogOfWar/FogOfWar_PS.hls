// This module is intended for us by PIXEL SHADERS
// TODO:  Rename the file to clearly convey that fact?


// This is the visibility map generated by the game as the players move through the world.
sampler FOW_MAP : register (s6);

// This is the artist authored coloration and FoW density adjustment texture that ships with the map.
sampler FOW_OVERLAY_MAP : register(s10);

#ifdef ANIMATE_FOW_OVERLAY_UV
float4 FOG_OVERLAY_UV_ANIMATE : register(c27); // { scale.x, scale.y, offset.x, offset.y }
#endif

float4 FOW_EDGE_CONTROL : register(c12); // R3D_SHADER_PS_CONSTANT_FOW_EDGE_CONTROL
//float4 FOW_EDGE_COLOR   : register(c13); // R3D_SHADER_PS_CONSTANT_FOW_EDGE_COLOR


// Input 0 means zero visibility (fully in FoW), input 1 means fully clear.
//  When active, we scale and shift this range to compress the response curve.
float TempFogEdgeSharpener(float input)
{
#if 0   
    // This is designed to sharpen the edge of FoW by causing the 0-1 fog control value to move more quickly from limit to limit
    const float finalScale = FOW_EDGE_CONTROL.x;
    const float finalShift = FOW_EDGE_CONTROL.y;
    return saturate(input * finalScale + finalShift);
#else
    return input;
#endif
}


// This function introduces a "tint" color to the transition zone between fully visible and fully fogged.
// This is used at present to give a colored edge to Fog Of War on SRU.
// It has no effect if the oneOverTintPoint term is zero.
float3 TempFogEdgeColorizer(float3 fowColor, float vis)
{
#if 1
    // Fog target color goes from texture suggested color to the tinted edge color in the fogged (0) to partically clear (tintPoint) range.
    // TODO:  I _think_ if we make this a 4 wide vector, we could allow the edge tint to also control the fog intensity at the edge for "free".
    float3 edgeColor = {0.2f, 0.07f, 0.06f};    // Reddish for now.  TODO:  Use FOW_EDGE_COLOR instead once it is available from the engine!
    float oneOverTintPoint = FOW_EDGE_CONTROL.z;

    return lerp(fowColor, edgeColor, saturate(vis*oneOverTintPoint));
#else
    return fowColor;
#endif
}


float4 GetFogOfWarFactors(float2 uv)
{
    // Fetches the artist drawn color/density map and the machine generated visibility
    // fowVis interpolates between clear (1.0) and the artist authored fog density (0.0 is MIN visibility, so MAX fog)
#ifdef ANIMATE_FOW_OVERLAY_UV
    float4 fowOverlay = tex2D(FOW_OVERLAY_MAP, uv*FOG_OVERLAY_UV_ANIMATE.xy+FOG_OVERLAY_UV_ANIMATE.zw);
#else
    float4 fowOverlay = tex2D(FOW_OVERLAY_MAP, uv);
#endif

    // Fetch the machine generated visiblity map (1.0 means visible, 0.0 means obscured)
    float  fowVis     = tex2D(FOW_MAP, uv).r;
    fowVis = TempFogEdgeSharpener(fowVis);
#ifdef FOW_IGNORE_VISIBILITY
    // This will cause the preceding work to optimize away...
    fowVis = 0.0f;
#endif

    // Combine the two to get the desired fog density at this pixel
    // fowVis interpolates between clear (1.0) and the artist authored fog density (0.0 is MIN visibility, so MAX fog)
    float visibility = lerp(fowOverlay.a, 1.0f, fowVis);
    fowOverlay.a = visibility;

    // Adjust target fog color in the transition region to get a tinted edge
    fowOverlay.rgb = TempFogEdgeColorizer(fowOverlay.rgb, fowVis);

    return fowOverlay;
}

// Lower fadeInByHeight values drive visiblity down (more fog), but computed visibility never goes up
float4 GetFogOfWarFactorsWithFadeTowardFogged(float2 uv, float fadeInByHeight)
{
    // Fetches the artist drawn color/density map and the machine generated visibility
    // fowVis interpolates between clear (1.0) and the artist authored fog density (0.0 is MIN visibility, so MAX fog)
#ifdef ANIMATE_FOW_OVERLAY_UV
    float4 fowOverlay = tex2D(FOW_OVERLAY_MAP, uv*FOG_OVERLAY_UV_ANIMATE.xy+FOG_OVERLAY_UV_ANIMATE.zw);
#else
    float4 fowOverlay = tex2D(FOW_OVERLAY_MAP, uv);
#endif

    // Fetch the machine generated visiblity map (1.0 means visible, 0.0 means obscured)
    float  fowVis     = tex2D(FOW_MAP, uv).r;
    fowVis = TempFogEdgeSharpener(fowVis);
#ifdef FOW_IGNORE_VISIBILITY
    // This will cause the preceding work to optimize away...
    fowVis = 0.0f;
#endif

    // Combine the two to get the desired fog density at this pixel
    // Using the product of the fade control and visibility values results in a lerp that can be forced to zero by either term,
    // and maxes out at the value of the other term if one of the terms is 1.0.
    // NOTE:  This is the same as lerp(0.0f, fowVis, fadeInByHeight)
    //        Which is the same as lerp(fowVis, 0.0f, 1-fadeInByHeight) which would allow us to unify with the function below (at the cost of an add)
    float t = fowVis*fadeInByHeight;

    // Fog density goes from the texture suggested opacity to 1.0 (clear) based on our fog control interpolater
    float visibility = lerp(fowOverlay.a, 1.0f, t);
    fowOverlay.a = visibility;

    // Adjust target fog color in the transition region to get a tinted edge
    fowOverlay.rgb = TempFogEdgeColorizer(fowOverlay.rgb, fowVis);

    return fowOverlay;
}

// Higher fadeOutByHeight values drive visibility up (less fog), but computed visibility never goes down
float4 GetFogOfWarFactorsWithFadeTowardClear(float2 uv, float fadeOutByHeight)
{
    // Fetches the artist drawn color/density map and the machine generated visibility
    // fowVis interpolates between clear (1.0) and the artist authored fog density (0.0 is MIN visibility, so MAX fog)
#ifdef ANIMATE_FOW_OVERLAY_UV
    float4 fowOverlay = tex2D(FOW_OVERLAY_MAP, uv*FOG_OVERLAY_UV_ANIMATE.xy+FOG_OVERLAY_UV_ANIMATE.zw);
#else
    float4 fowOverlay = tex2D(FOW_OVERLAY_MAP, uv);
#endif

    // Fetch the machine generated visiblity map (1.0 means visible, 0.0 means obscured)
    float  fowVis     = tex2D(FOW_MAP, uv).r;
    fowVis = TempFogEdgeSharpener(fowVis);
#ifdef FOW_IGNORE_VISIBILITY
    // This will cause the preceding work to optimize away...
    fowVis = 0.0f;
#endif

    // Combine the two to get the desired fog density at this pixel
    // This linear combination results in a value that is forced to 1.0 by either term being 1.0 and has a minimum value
    // limited by the other term if one of the terms is 0.0
    float t = lerp(fowVis, 1.0f, fadeOutByHeight);

    // Fog density goes from the texture suggested opacity to 1.0 (clear) based on our fog control interpolater
    float visibility = lerp(fowOverlay.a, 1.0f, t);
    fowOverlay.a = visibility;

    // Adjust target fog color in the transition region to get a tinted edge
    fowOverlay.rgb = TempFogEdgeColorizer(fowOverlay.rgb, fowVis);

    return fowOverlay;
}

