#include "IOParam/IODefine_VS.hls"
#include "../FogOfWar/FogOfWar_VS.hls"


//selfillumination in W
float4 	SKIN_PARAMETERS : register(c17);

/// Bones
column_major float4x3 BONES[68] 	: register(c24);


/////////////////////////////////////////////////////////////////////////////////////
///
/// Calculate the attenuated contribution from a single point light
///
/////////////////////////////////////////////////////////////////////////////////////
float4 
	CalculatePointLight
	(
		float3 position,				/// Vertex position
		float3 normal,				/// Vertex normal
		float4 lightPosition,				/// Light position
		float4 lightColor					/// Light color
	)
{
	// Vertex to light
	float3 vertexToLight = lightPosition.xyz - position.xyz;

	// Attenuate with distance to light based on attentuation factor in W component of light position
	float attenuation = 1.0f - saturate(length(vertexToLight) / lightPosition.w);

	// N dot L
	float NdotL = dot(normalize(vertexToLight), normal);

	// Compute final attenuated color
	float4 finalColor = saturate(max(NdotL,0)*lightColor*attenuation); 

	// Return
	return finalColor;
}



/////////////////////////////////////////////////////////////////////////////////////
///
///
///
/////////////////////////////////////////////////////////////////////////////////////
void 
	main
	(
		float3		vPos :		X3D_VSIN_POSITION,
		float3		vNormal:	X3D_VSIN_NORMAL,
		float2		vUV1:		X3D_VSIN_TEXCOORD0,
		blendindex4	vBlendIndices : X3D_VSIN_BLENDINDICES,
		float4		vBlendWeight : 	X3D_VSIN_BLENDWEIGHT,
		out float4	vPosOut:	POSITION,
		out float4	vColorOut:	COLOR0,
		out float4	vColorOut1:	COLOR1,
		out float2	vTexOut1:	TEXCOORD0,
        out float4  out_texcoord4:	TEXCOORD1
#ifndef DISABLE_SHADOWS
		, out float3	vTexSM:		TEXCOORD2
#endif
#ifdef	SEPARATE_ALPHA_UV
		, out float2	vAlphaUV:	TEXCOORD3
#endif
#ifdef REFLECTIVE
		, out float4	out_reflectRay		  : TEXCOORD4
		, out float3	out_worldNormal   : TEXCOORD5
		, out float3	vReflTint		  : TEXCOORD6
#endif

	)
{
	// Compute skinned local position
	float3 worldPosition = float3(0,0,0);
	for (int i = 0; i < NUM_BLEND_WEIGHTS; ++i)
	{
		blendindex boneIndex = vBlendIndices[i];
		float weight = vBlendWeight[i];
		worldPosition += (mul(float4(vPos, 1.f), BONES[boneIndex]) * weight);
	}

	// Output homogeneous position
	vPosOut = mul(float4(worldPosition.xyz, 1.0f), mProj ); 

	// Output texture coordinate using texture transform
	vTexOut1.xy = vUV1 * vUVTransform.xy + vUVTransform.zw;

#ifdef SEPARATE_ALPHA_UV
	vAlphaUV = vUV1;
#endif

#ifndef DISABLE_SHADOWS
	// Output shadow position
	vTexSM = mul(float4(worldPosition.xyz, 1.0f), mShadowProj).xyz;
#endif

	// Compute world normal
	float3 worldNormal = float3(0,0,0);
	for (int j = 0; j < NUM_BLEND_WEIGHTS; ++j)
	{
		blendindex boneIndex = vBlendIndices[j];
		float weight = vBlendWeight[j];
		worldNormal += (mul(float4(vNormal, 0.f), BONES[boneIndex]) * weight);
	}
	worldNormal = normalize(worldNormal.xyz);  
	
	// N dot L saturated
	float NdotL = saturate(dot(-vLightVec1.xyz, worldNormal.xyz));

	// Incident sun light
	float3 incidentSunLight = NdotL * vLightColor.xyz;

	// Output sun light is incident sun light
	vColorOut.xyz = saturate(incidentSunLight);
	vColorOut.a=1;

	float4 DColor = float4(0,0,0,0);
#ifndef DISABLE_POINT_LIGHTS
	// Compute contribution from environmental point lights
	for (int k=0;k<4;k++)
	{
		DColor += CalculatePointLight(worldPosition, worldNormal.xyz, POINT_LIGHTS_POSITION[k], POINT_LIGHTS_COLOR[k]);
	}
	DColor = saturate(DColor);
#endif
	vColorOut1 = saturate(DColor);
	
	// Fog of war and clouds
	out_texcoord4.xy = FogOfWarTextureCoordinates(worldPosition.xyz).xy;
	out_texcoord4.zw = worldPosition.xz*vCloudsParam.xx + vCloudsParam.yz;


#ifdef REFLECTIVE
	float fresnelPower = vReflection.x;
	float3 eyeRay = normalize( worldPosition.xyz - vCamera.xyz );
	out_worldNormal    = worldNormal.xyz;
	
	
	out_reflectRay.xyz = reflect(eyeRay, out_worldNormal );
	
	//store the fresnel factor in the w component of the reflectRay. This is done in the vertex shader, so a proper power can be used.
	//base fresnel is the 0 to 1 reflection intensity based on the fresnel power.
	float baseFresnel = 1.0f - pow( saturate( dot(-eyeRay, worldNormal.xyz) ), fresnelPower );
	//the final scaled result factors in the minimum and maximum reflection intensities supplied by the artists.
	out_reflectRay.w  = lerp(vReflection.y, vReflection.z, baseFresnel);
	//the view dependent reflection color is also keyed off the fresnel.
	vReflTint = lerp(1.0f, vReflectionFColor, out_reflectRay.w);
#endif

}
