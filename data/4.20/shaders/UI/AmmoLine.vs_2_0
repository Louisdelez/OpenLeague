float4x4 pMtx : register(c0);

float4 params : register(c8);

void main(	float2 posIn: X3D_VSIN_POSITION,
			float4 col0: X3D_VSIN_COLOR0,
			float2 tex0: X3D_VSIN_TEXCOORD0,
			out float4 posOut: POSITION,
			out float4 color0Out: COLOR0)
{
	float x = params.x;
	float y = params.y;
	float len = params.z;
	float2 pos = posIn + float2(x*tex0.x*len, y*tex0.y*len);
	posOut = mul(pMtx, float4(pos,0,1));
	color0Out = col0.VCOLORSWIZZLE;
}
