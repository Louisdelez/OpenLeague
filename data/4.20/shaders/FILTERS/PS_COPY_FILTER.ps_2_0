////////////////////////////////////////////////////////////////
///
/// Samplers
///
////////////////////////////////////////////////////////////////
sampler SAMPLER : register (s0);		///< texture to blur

////////////////////////////////////////////////////////////////
///
/// main
///
////////////////////////////////////////////////////////////////
void
	main
	(
		float2		in_texcoord0	: TEXCOORD0,
		out float4	out_color0		: COLOR0
	)
{
	float4 ret = tex2D(SAMPLER, in_texcoord0);
	out_color0 = ret;
}
