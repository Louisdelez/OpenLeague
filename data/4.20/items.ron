    "3340": (
        id: "3340", name: "Totem baliseur (relique)", cost: 0,
        modifiers: [],
        icon: "ui/items/3340.png",
        categories: ["Active", "Jungle", "Trinket", "Vision"],
        recipe: [],
        total_cost: 0,
        description: "Limité à 1 relique.\n\nPropriété active : pose une Balise camouflée qui dure 60 sec (120 sec de récupération).\n\nAu niveau 9, la durée de la balise passe à 120 sec.\n\nLimité à 3 Balises camouflées sur la carte par joueur.\n\n(Les reliques ne peuvent pas être utilisées pendant les 30 premières secondes de la partie. Vendre une relique désactive l'utilisation des reliques pendant 120 secondes.)",
        sell_price: 0,
